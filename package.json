{
  "name": "dsh-subagent-vision",
  "version": "0.1.6",
  "description": "dsh bundle: subagent_vision — delegate image reading to a vision-capable model from a text-only session, plus paste-to-path so pasted images reach the subagent as file paths.",
  "type": "module",
  "main": "./index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niuniuaba/dsh-subagent-vision.git"
  },
  "homepage": "https://github.com/niuniuaba/dsh-subagent-vision",
  "bugs": {
    "url": "https://github.com/niuniuaba/dsh-subagent-vision/issues"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.2-alpha.5 <0.2",
    "@deepseek-ai/dsh-jobs": ">=0.1.2-alpha.5 <0.2",
    "@deepseek-ai/dsh-llm": ">=0.1.2-alpha.5 <0.2",
    "@deepseek-ai/dsh-settings": ">=0.1.2-alpha.5 <0.2",
    "@deepseek-ai/dsh-subagent": ">=0.1.2-alpha.5 <0.2",
    "@deepseek-ai/dsh-tools": ">=0.1.2-alpha.5 <0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "tool.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "bundle",
    "vision",
    "subagent"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.2-rc.1",
      "dshReleases": {
        "0.1.2-alpha.5": "compatible",
        "0.1.2-rc.1": "compatible",
        "0.1.3-alpha.2": "compatible"
      }
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": false
    }
  }
}
